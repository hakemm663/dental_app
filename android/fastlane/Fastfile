default_platform(:android)

# To run a lane locally, from repo root:
#   cd android && bundle exec fastlane <lane>
# To run from CI: see .github/workflows/flutter-ci.yml

# This file lives at android/fastlane/Fastfile, so `..` is android/ and
# `../..` is the repo root. Use the latter — Flutter outputs build
# artifacts under <repo>/build/, and the firebase_app_distribution plugin
# needs an absolute path so it doesn't depend on cwd.
REPO_ROOT = File.expand_path("../..", __dir__)
APK_OUTPUT_DIR = File.join(REPO_ROOT, "build", "app", "outputs", "flutter-apk")

# Firebase App IDs for the Android apps registered in the docdoc-59d1a
# project. Non-secret — these ship inside google-services.json and the
# compiled APK. Mapping them here keeps lanes self-describing.
FIREBASE_ANDROID_APP_IDS = {
  "dev"        => "1:164969170208:android:d8424e1e8d4a170c4f0345",
  "staging"    => "1:164969170208:android:1384a69dc72c97d14f0345",
  "production" => "1:164969170208:android:f1da96ae073a554b4f0345",
}.freeze

# ── Helpers ──────────────────────────────────────────────────────────────

def flutter_build_apk(flavor, target)
  sh("cd #{REPO_ROOT} && flutter build apk --flavor #{flavor} " \
     "-t #{target} --release --no-tree-shake-icons " \
     "--dart-define-from-file=env/#{flavor}.json")
end

def flutter_build_aab(flavor, target)
  sh("cd #{REPO_ROOT} && flutter build appbundle --flavor #{flavor} " \
     "-t #{target} --release --no-tree-shake-icons " \
     "--dart-define-from-file=env/#{flavor}.json")
end

def head_release_notes
  subject = `git -C #{REPO_ROOT} log -1 --pretty=%s`.strip
  sha     = `git -C #{REPO_ROOT} log -1 --pretty=%h`.strip
  "#{subject} (#{sha})"
rescue StandardError
  "Internal build via Fastlane."
end

# Upload an already-built APK to Firebase App Distribution. Accepts the
# kwargs you'd typically tweak per-release: `groups:`, `testers:`,
# `release_notes:`. Leave `release_notes:` unset to derive notes from the
# head commit.
def upload_apk_to_firebase(flavor:, apk_filename:, groups: nil, testers: nil, release_notes: nil)
  token = ENV["FIREBASE_CLI_TOKEN"]
  UI.user_error!("FIREBASE_CLI_TOKEN env var not set") if token.nil? || token.empty?

  firebase_app_distribution(
    app: FIREBASE_ANDROID_APP_IDS.fetch(flavor),
    firebase_cli_token: token,
    android_artifact_type: "APK",
    android_artifact_path: File.join(APK_OUTPUT_DIR, apk_filename),
    groups: groups,
    testers: testers,
    release_notes: release_notes || head_release_notes
  )
end

platform :android do
  # ── Build lanes (local use; CI builds inline) ──────────────────────────

  desc "Assemble a dev release APK → build/app/outputs/flutter-apk/app-dev-release.apk"
  lane :build_dev do
    flutter_build_apk("dev", "lib/main_dev.dart")
  end

  desc "Assemble a staging release APK → build/app/outputs/flutter-apk/app-staging-release.apk"
  lane :build_staging do
    flutter_build_apk("staging", "lib/main_staging.dart")
  end

  desc "Assemble a production release APK → build/app/outputs/flutter-apk/app-production-release.apk"
  lane :build_production do
    flutter_build_apk("production", "lib/main_production.dart")
  end

  desc "Assemble a production release AAB for Play Store (requires android/key.properties)"
  lane :build_production_aab do
    flutter_build_aab("production", "lib/main_production.dart")
  end

  # ── Distribute lane (Firebase App Distribution) ────────────────────────

  desc "Build the production APK and ship it to Firebase App Distribution. " \
       "Triggered automatically on push to development; runnable locally with " \
       "FIREBASE_CLI_TOKEN exported."
  lane :firebase_distribution do
    flutter_build_apk("production", "lib/main_production.dart")
    upload_apk_to_firebase(
      flavor: "production",
      apk_filename: "app-production-release.apk",
      groups: "internal-testers",
      release_notes: "Test new features and bug fixes with this internal build. Feedback welcome!"
    )
  end
end
