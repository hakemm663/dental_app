# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android signing — never commit these
android/key.properties
android/app/*.jks
android/app/*.keystore

# Firebase Functions secrets
functions/.env
functions/.env.local

# Local dev credentials — never commit
.dev-secrets/

# env/<flavor>.json holds only client-facing identifiers (Supabase URL +
# publishable anon key, Firebase project ID, Agora app ID, Maps keys,
# Paymob public key). These ship inside the compiled binary and are not
# secrets — they're committed. Real secrets (Supabase service role,
# Paymob HMAC, Agora app certificate, Firebase admin JSON) live on
# Firebase Functions and never touch the Flutter app.

# Android signing extras
*.keystore
key.properties

# Apple signing — never commit
*.p8
*.p12
*.mobileprovision
*.cer

# Service-account JSONs (Firebase Admin, Play Console, etc.)
**/service-account*.json
**/google-services-account*.json
**/play-store-key.json

# Fastlane local state
android/fastlane/report.xml
ios/fastlane/report.xml
android/fastlane/Preview.html
ios/fastlane/Preview.html
**/fastlane/README.md

