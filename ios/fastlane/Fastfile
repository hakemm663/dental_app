default_platform(:ios)

# Apple Developer account is not yet active — TestFlight lanes are wired
# but require a few one-line edits to ios/fastlane/Appfile and an API key
# at ios/fastlane/AuthKey_<KEY_ID>.p8 before they will run. See the
# `## Fastlane (iOS) — TestFlight readiness` section of
# docs/release_flavors_ci.md for the activation checklist.

# --- Repo layout helpers ----------------------------------------------------
# Fastlane runs from ios/, so `..` is the repo root.
REPO_ROOT  = File.expand_path("..", __dir__)
ENV_DIR    = File.join(REPO_ROOT, "env")
BUILD_DIR  = File.join(REPO_ROOT, "build", "ios", "ipa")

def flutter_build_ios_no_codesign(flavor, target)
  sh("cd #{REPO_ROOT} && flutter build ios --flavor #{flavor} " \
     "-t #{target} --no-codesign " \
     "--dart-define-from-file=env/#{flavor}.json")
end

def flutter_build_ipa(flavor, target, export_method: "app-store")
  sh("cd #{REPO_ROOT} && flutter build ipa --flavor #{flavor} " \
     "-t #{target} --release " \
     "--dart-define-from-file=env/#{flavor}.json " \
     "--export-method=#{export_method}")
end

platform :ios do
  # --- Build verification (works today, no Apple Dev account needed) -------

  desc "Compile the dev .app bundle (no code signing)"
  lane :build_dev do
    flutter_build_ios_no_codesign("dev", "lib/main_dev.dart")
  end

  desc "Compile the staging .app bundle (no code signing)"
  lane :build_staging do
    flutter_build_ios_no_codesign("staging", "lib/main_staging.dart")
  end

  desc "Compile the production .app bundle (no code signing)"
  lane :build_production do
    flutter_build_ios_no_codesign("production", "lib/main_production.dart")
  end

  # --- TestFlight (gated on Apple Dev account activation) ------------------

  desc "Build a signed production .ipa for TestFlight"
  lane :build_production_ipa do
    flutter_build_ipa("production", "lib/main_production.dart")
  end

  desc "Build + upload the production app to TestFlight"
  lane :beta do
    require_apple_credentials!

    flutter_build_ipa("production", "lib/main_production.dart")

    upload_to_testflight(
      ipa: File.join(BUILD_DIR, "docdoc.ipa"),
      skip_waiting_for_build_processing: true,
      api_key_path: ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH"),
      changelog: ENV.fetch("TESTFLIGHT_CHANGELOG", "Internal build via Fastlane.")
    )
  end

  # --- Guards --------------------------------------------------------------

  def require_apple_credentials!
    missing = %w[
      APP_STORE_CONNECT_API_KEY_PATH
      APP_STORE_CONNECT_API_KEY_ID
      APP_STORE_CONNECT_API_ISSUER_ID
    ].reject { |k| ENV[k] && !ENV[k].empty? }

    return if missing.empty?

    UI.user_error!(
      "Apple Developer account not configured. Set: #{missing.join(', ')}\n" \
      "See docs/release_flavors_ci.md for the activation checklist."
    )
  end
end
