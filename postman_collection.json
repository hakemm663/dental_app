  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// VCare Live — Collection-level pre-request script",
          "// Skips auth on public endpoints and auto-refreshes token when missing/invalid.",
          "",
          "const rawUrl = pm.request.url.toString();",
          "const isAuthEndpoint = /\\/auth\\/(login|register|logout)\\b/.test(rawUrl);",
          "",
          "if (isAuthEndpoint) {",
          "    // Do nothing — auth endpoints handle their own flow.",
          "    return;",
          "}",
          "",
          "const baseUrl = pm.collectionVariables.get(\"url\");",
          "const email = pm.collectionVariables.get(\"email\");",
          "const password = pm.collectionVariables.get(\"password\");",
          "const token = pm.collectionVariables.get(\"token\");",
          "",
          "if (!baseUrl) {",
          "    console.error(\"[VCare] Collection variable `url` is not set.\");",
          "    return;",
          "}",
          "",
          "if (token) {",
          "    // Token already available; proceed.",
          "    return;",
          "}",
          "",
          "if (!email || !password) {",
          "    console.warn(\"[VCare] No token and no credentials. Run Register or Login first to populate the `token` collection variable.\");",
          "    return;",
          "}",
          "",
          "// Attempt auto-login",
          "pm.sendRequest({",
          "    url: baseUrl + \"/auth/login\",",
          "    method: \"POST\",",
          "    header: { \"Accept\": \"application/json\" },",
          "    body: {",
          "        mode: \"urlencoded\",",
          "        urlencoded: [",
          "            { key: \"email\", value: email },",
          "            { key: \"password\", value: password }",
          "        ]",
          "    }",
          "}, function (err, res) {",
          "    if (err) {",
          "        console.error(\"[VCare] Auto-login network error:\", err);",
          "        return;",
          "    }",
          "    try {",
          "        const body = res.json();",
          "        const fetched = body && body.data && body.data.token;",
          "        if (fetched) {",
          "            pm.collectionVariables.set(\"token\", fetched);",
          "            console.log(\"[VCare] Auto-login succeeded, token set.\");",
          "        } else {",
          "            console.warn(\"[VCare] Auto-login response had no token:\", body && body.message);",
          "        }",
          "    } catch (e) {",
          "        console.error(\"[VCare] Auto-login parse error:\", e);",
          "    }",
          "});"
        ]
      }
    },
