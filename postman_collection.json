      "name": "Auth Module",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Register successful and token captured\", function () {",
                  "    pm.expect(pm.response.code, \"status\").to.be.oneOf([200, 201]);",
                  "    const jsonData = pm.response.json();",
                  "    const token = jsonData && jsonData.data && jsonData.data.token;",
                  "    if (token) {",
                  "        pm.collectionVariables.set(\"token\", token);",
                  "        // Extract the email/password actually sent (resolved after variable substitution)",
                  "        try {",
                  "            const sent = pm.request.body.toString(); // urlencoded string",
                  "            const params = new URLSearchParams(sent);",
                  "            const sentEmail = params.get(\"email\");",
                  "            const sentPassword = params.get(\"password\");",
                  "            if (sentEmail) pm.collectionVariables.set(\"email\", sentEmail);",
                  "            if (sentPassword) pm.collectionVariables.set(\"password\", sentPassword);",
                  "        } catch (e) {",
                  "            console.warn(\"[VCare] Could not persist registered email/password:\", e);",
                  "        }",
                  "        console.log(\"[VCare] Register OK. Token saved.\");",
                  "    } else {",
                  "        console.warn(\"[VCare] Register response did not contain data.token:\", jsonData);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
